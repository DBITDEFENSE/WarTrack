# WarTrack Environment Variables
# Copy this to .env and fill in your keys

# Required for AI briefings and Nexus advisor
ANTHROPIC_API_KEY=sk-ant-...

# Required for voice/TTS output
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Required for news headlines
GNEWS_API_KEY=your-gnews-key

# Required for user auth and data persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# Optional: ADS-B Exchange for GPS jamming detection ($10/mo RapidAPI)
ADSBX_API_KEY=

# Optional: Windy Webcams for live camera layer
WINDY_WEBCAMS_KEY=

# Optional: Custom JWT secret (defaults to dev secret)
JWT_SECRET=your-secret-here
